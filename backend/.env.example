# Copy this file to .env and fill in real values. .env is in .gitignore;
# this example file is committed so you can see which settings exist.

# Secret that every request must send in the X-API-Key header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ONTRACK_API_KEY=change-me

# SQLite database file.
ONTRACK_DB=ontrack.db

# Which web origins may call the API from a browser (comma-separated).
ONTRACK_CORS_ORIGINS=http://localhost:5173
